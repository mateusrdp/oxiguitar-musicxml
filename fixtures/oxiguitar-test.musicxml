    <measure number="4">
      <barline location="left"><ending number="2" type="start"/></barline>
      <direction>
        <direction-type><words>let ring</words></direction-type>
      </direction>
      <note>
        <rest measure="yes"/>
        <duration>18</duration><voice>1</voice><staff>1</staff>
      </note>
      <barline location="right"><bar-style>light-heavy</bar-style><ending number="2" type="discontinue"/></barline>
    </measure>
